@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = "PersonalData";
}

<div class="manage-container">
    <div class="manage-sidebar">
        <h3 class="sidebar-title"><i class="fas fa-cog"></i> Settings</h3>
        <nav class="settings-nav">
            <a class="nav-item" asp-page="./Index">
                <i class="fas fa-user-circle"></i>
                <span>Profile</span>
            </a>
            <a class="nav-item" asp-page="./Email">
                <i class="fas fa-envelope"></i>
                <span>Email</span>
            </a>
            <a class="nav-item" asp-page="./ChangePassword">
                <i class="fas fa-key"></i>
                <span>Password</span>
            </a>
            <a class="nav-item" asp-page="./TwoFactorAuthentication">
                <i class="fas fa-shield-alt"></i>
                <span>Two-Factor</span>
            </a>
            <a class="nav-item active" asp-page="./PersonalData">
                <i class="fas fa-database"></i>
                <span>Personal Data</span>
            </a>
        </nav>
    </div>

    <div class="manage-content">
        <div class="content-header">
            <div>
                <h2><i class="fas fa-database"></i> Personal Data</h2>
                <p>Download or delete your personal data</p>
            </div>
        </div>

        <partial name="_StatusMessage" for="StatusMessage" />

        <div class="form-card">
            <div class="info-note">
                <i class="fas fa-info-circle"></i>
                <div>
                    <strong>Your Personal Data</strong>
                    <p>Your account contains personal data that you have given us. You can download this data in JSON format or permanently delete your account.</p>
                </div>
            </div>

            <div class="form-actions">
                <form method="post" asp-page-handler="Download" style="display: inline-block;">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-download"></i> Download Your Data
                    </button>
                </form>

                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                    <i class="fas fa-trash"></i> Delete Account
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="fas fa-exclamation-triangle" style="color: #ef4444;"></i> Delete Account
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="warning-box">
                    <i class="fas fa-exclamation-triangle"></i>
                    <div>
                        <strong>Warning: This action cannot be undone!</strong>
                        <p>Deleting your account will permanently remove all your data from our system including your profile, attendance records, leave requests, and payslips.</p>
                    </div>
                </div>
                <form method="post" asp-page-handler="Delete">
                    <div class="form-group">
                        <label asp-for="Input.Password">
                            <i class="fas fa-lock"></i> Enter your password to confirm
                        </label>
                        <input asp-for="Input.Password" type="password" class="form-control" placeholder="Enter your password" required />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fas fa-times"></i> Cancel
                        </button>
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash"></i> Delete My Account
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/account-manage.css" asp-append-version="true" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
