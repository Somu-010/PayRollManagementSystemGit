@page
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Two-Factor Authentication";
    ViewData["ActivePage"] = "TwoFactorAuthentication";
}

<div class="manage-container">
    <div class="manage-sidebar">
        <h3 class="sidebar-title"><i class="fas fa-cog"></i> Settings</h3>
        <nav class="settings-nav">
            <a class="nav-item" asp-page="./Index">
                <i class="fas fa-user-circle"></i>
                <span>Profile</span>
            </a>
            <a class="nav-item" asp-page="./Email">
                <i class="fas fa-envelope"></i>
                <span>Email</span>
            </a>
            <a class="nav-item" asp-page="./ChangePassword">
                <i class="fas fa-key"></i>
                <span>Password</span>
            </a>
            <a class="nav-item active" asp-page="./TwoFactorAuthentication">
                <i class="fas fa-shield-alt"></i>
                <span>Two-Factor</span>
            </a>
            <a class="nav-item" asp-page="./PersonalData">
                <i class="fas fa-database"></i>
                <span>Personal Data</span>
            </a>
        </nav>
    </div>

    <div class="manage-content">
        <div class="content-header">
            <div>
                <h2><i class="fas fa-shield-alt"></i> Two-Factor Authentication</h2>
                <p>Add an extra layer of security to your account</p>
            </div>
        </div>

        <div class="form-card">
            <div class="info-note">
                <i class="fas fa-info-circle"></i>
                <div>
                    <strong>Coming Soon</strong>
                    <p>Two-factor authentication will be available in a future update. This feature will allow you to add an extra layer of security to your account using authenticator apps or SMS verification.</p>
                </div>
            </div>

            <div style="text-align: center; padding: 40px 20px;">
                <i class="fas fa-shield-alt" style="font-size: 64px; color: #2193b0; opacity: 0.3; margin-bottom: 20px;"></i>
                <h3 style="color: #5a6c7d; font-weight: 500;">Feature Under Development</h3>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/account-manage.css" asp-append-version="true" />
