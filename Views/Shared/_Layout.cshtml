@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    // Declare variables at page level
    var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var userRoles = currentUser != null ? await UserManager.GetRolesAsync(currentUser) : new List<string>();
    var userRole = userRoles.FirstOrDefault() ?? "User";
    var isAdmin = userRoles.Contains("Admin");
    var isHR = userRoles.Contains("HR");
    var isAdminOrHR = isAdmin || isHR;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FiroTech</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PayRollManagementSystem.styles.css" asp-append-version="true" />
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        :root {
            --sidebar-width: 260px;
            --header-height: 70px;
            --primary-color: #2193b0;
            --primary-light: #6dd5ed;
            --primary-gradient: linear-gradient(135deg, #6dd5ed 0%, #2193b0 100%);
            --sidebar-bg: #2c3e50;
            --sidebar-hover: #34495e;
            --text-muted: #bdc3c7;
            --bg-light: #f8fafb;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: var(--bg-light);
            min-height: 100vh;
        }

        /* Sidebar Styles */
        .dashboard-sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background: var(--sidebar-bg);
            color: white;
            overflow-y: auto;
            transition: transform 0.3s ease;
            z-index: 1000;
        }

        .dashboard-sidebar::-webkit-scrollbar {
            width: 6px;
        }

        .dashboard-sidebar::-webkit-scrollbar-track {
            background: var(--sidebar-bg);
        }

        .dashboard-sidebar::-webkit-scrollbar-thumb {
            background: var(--sidebar-hover);
            border-radius: 3px;
        }

        .sidebar-header {
            padding: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sidebar-logo {
            width: 40px;
            height: 40px;
            background: var(--primary-gradient);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 18px;
        }

        .sidebar-brand {
            font-size: 20px;
            font-weight: 700;
            color: white;
        }

        .sidebar-nav {
            padding: 20px 0;
        }

        .nav-section-title {
            padding: 15px 20px 10px;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-muted);
            font-weight: 600;
        }

        .nav-item {
            margin: 4px 12px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            color: rgba(255, 255, 255, 0.7);
            text-decoration: none;
            border-radius: 10px;
            transition: all 0.3s ease;
            font-size: 14px;
        }

        .nav-link:hover {
            background: var(--sidebar-hover);
            color: white;
            transform: translateX(4px);
        }

        .nav-link.active {
            background: var(--primary-gradient);
            color: white;
            box-shadow: 0 4px 12px rgba(33, 147, 176, 0.3);
        }

        .nav-icon {
            width: 20px;
            height: 20px;
            margin-right: 12px;
            font-size: 18px;
        }

        /* Dropdown Navigation */
        .dropdown-nav {
            position: relative;
        }

        .dropdown-toggle {
            position: relative;
            cursor: pointer;
        }

        .dropdown-icon {
            position: absolute;
            right: 16px;
            font-size: 10px;
            transition: transform 0.3s ease;
        }

        .dropdown-toggle[aria-expanded="true"] .dropdown-icon {
            transform: rotate(180deg);
        }

        .submenu {
            background: rgba(0, 0, 0, 0.1);
            border-radius: 8px;
            margin: 4px 8px;
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .submenu-link {
            padding: 10px 16px 10px 45px !important;
            font-size: 13px;
        }

        .submenu-link:hover {
            background: rgba(255, 255, 255, 0.05);
            transform: translateX(2px);
        }

        .submenu-link.active {
            background: rgba(109, 213, 237, 0.2);
            border-left: 3px solid var(--primary-light);
        }

        /* Main Content Area */
        .dashboard-main {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Header Styles */
        .dashboard-header {
            height: var(--header-height);
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid #e8f4f8;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 15px rgba(52, 152, 219, 0.08);
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .mobile-menu-btn {
            display: none;
            background: none;
            border: none;
            font-size: 24px;
            cursor: pointer;
            color: #2c3e50;
        }

        .page-title {
            font-size: 24px;
            font-weight: 600;
            color: #2c3e50;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        /* Notification Bell */
        .notification-bell {
            position: relative;
        }

        .bell-icon {
            position: relative;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #e8f4f8;
            border-radius: 10px;
            color: #2193b0;
            text-decoration: none;
            transition: all 0.3s;
        }

        .bell-icon:hover {
            background: #d0ecf3;
            transform: scale(1.05);
        }

        .bell-icon i {
            font-size: 18px;
        }

        .notification-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background: #ef4444;
            color: white;
            border-radius: 50%;
            min-width: 20px;
            height: 20px;
            display: none;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 700;
            padding: 0 5px;
            box-shadow: 0 2px 8px rgba(239, 68, 68, 0.4);
            animation: pulse 2s infinite;
        }

        .notification-badge.active {
            display: flex;
        }

        @@keyframes pulse {
            0%, 100% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.1);
            }
        }

        .role-badge {
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
        }

        .role-admin { background: #fee2e2; color: #ef4444; }
        .role-hr { background: #dbeafe; color: #3b82f6; }
        .role-employee { background: #d1f4e0; color: #10b981; }

        .btn-logout {
            padding: 8px 16px;
            background: var(--primary-gradient);
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.3s ease;
            box-shadow: 0 2px 10px rgba(33, 147, 176, 0.2);
        }

        .btn-logout:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(33, 147, 176, 0.3);
        }

        /* Content Area */
        .dashboard-content {
            flex: 1;
            padding: 30px;
        }

        /* Footer */
        .dashboard-footer {
            padding: 20px 30px;
            background: white;
            border-top: 1px solid #e8f4f8;
            text-align: center;
            color: #5a6c7d;
            font-size: 14px;
        }

        /* Mobile Responsive */
        @@media (max-width: 768px) {
            .dashboard-sidebar {
                transform: translateX(-100%);
            }

            .dashboard-sidebar.active {
                transform: translateX(0);
            }

            .dashboard-main {
                margin-left: 0;
            }

            .mobile-menu-btn {
                display: block;
            }

            .user-details {
                display: none;
            }

            .dashboard-content {
                padding: 20px;
            }

            .page-title {
                font-size: 20px;
            }
        }

        /* Overlay for mobile */
        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 999;
        }

        .sidebar-overlay.active {
            display: block;
        }

        /* Auth Pages (Login/Register) - No Dashboard Layout */
        .auth-page {
            margin: 0 !important;
        }

        .auth-page .dashboard-sidebar,
        .auth-page .dashboard-header,
        .auth-page .dashboard-footer {
            display: none !important;
        }
    </style>
</head>
<body>
    @if (SignInManager.IsSignedIn(User))
    {
        <!-- Sidebar Overlay for Mobile -->
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <!-- Sidebar -->
        <aside class="dashboard-sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-logo">💼</div>
                <span class="sidebar-brand">FiroTech</span>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section-title">Main Menu</div>
                <ul class="list-unstyled">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                           asp-controller="Home" asp-action="Index">
                            <span class="nav-icon">📊</span>
                            Dashboard
                        </a>
                    </li>
                    @if (isAdminOrHR)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Employee" ? "active" : "")"
                               asp-controller="Employee" asp-action="Index">
                                <span class="nav-icon">👥</span>
                                Employees
                            </a>
                        </li>
                        
                        <!-- Master Data Dropdown -->
                        <li class="nav-item dropdown-nav">
                            <a class="nav-link dropdown-toggle @(new[] { "Department", "Designation", "Shift" }.Contains(ViewContext.RouteData.Values["controller"]?.ToString()) ? "active" : "")" 
                               href="#masterDataMenu" 
                               data-bs-toggle="collapse" 
                               role="button" 
                               aria-expanded="false">
                                <span class="nav-icon">⚙️</span>
                                Master Data
                                <i class="fas fa-chevron-down dropdown-icon"></i>
                            </a>
                            <div class="collapse submenu" id="masterDataMenu">
                                <ul class="list-unstyled">
                                    <li class="nav-item">
                                        <a class="nav-link submenu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Department" ? "active" : "")"
                                           asp-controller="Department" asp-action="Index">
                                            <span class="nav-icon">🏢</span>
                                            Departments
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link submenu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Designation" ? "active" : "")"
                                           asp-controller="Designation" asp-action="Index">
                                            <span class="nav-icon">💼</span>
                                            Designations
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link submenu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Shift" ? "active" : "")"
                                           asp-controller="Shift" asp-action="Index">
                                            <span class="nav-icon">⏰</span>
                                            Shifts
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Attendance" ? "active" : "")"
                               asp-controller="Attendance" asp-action="Index">
                                <span class="nav-icon">📅</span>
                                Attendance
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Leave" ? "active" : "")"
                               asp-controller="Leave" asp-action="Index">
                                <span class="nav-icon">🏖️</span>
                                Leave Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AllowanceDeduction" ? "active" : "")"
                               asp-controller="AllowanceDeduction" asp-action="Index">
                                <span class="nav-icon">💰</span>
                                Allowances & Deductions
                            </a>
                        </li>
                    }
                </ul>

                @if (isAdminOrHR)
                {
                    <div class="nav-section-title">Reports & Analytics</div>
                    <ul class="list-unstyled">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")"
                               asp-controller="Reports" asp-action="Index">
                                <span class="nav-icon">📈</span>
                                Reports
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Payroll" ? "active" : "")"
                               asp-controller="Payroll" asp-action="Index">
                                <span class="nav-icon">💵</span>
                                Payroll
                            </a>
                        </li>
                    </ul>
                }

                <div class="nav-section-title">Settings</div>
                <ul class="list-unstyled">
                    @if (isAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "UserManagement" ? "active" : "")"
                               asp-controller="UserManagement" asp-action="Index">
                                <span class="nav-icon">👥</span>
                                User Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CompanySettings" ? "active" : "")"
                               asp-controller="CompanySettings" asp-action="Index">
                                <span class="nav-icon">🏢</span>
                                Company Settings
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index">
                            <span class="nav-icon">⚙️</span>
                            Account Settings
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- Main Content -->
        <div class="dashboard-main">
            <!-- Header -->
            <header class="dashboard-header">
                <div class="header-left">
                    <button class="mobile-menu-btn" id="mobileMenuBtn">
                        ☰
                    </button>
                    <h1 class="page-title">@ViewData["Title"]</h1>
                </div>

                <div class="header-right">
                    <!-- Notification Bell -->
                    @if (isAdminOrHR)
                    {
                        <div class="notification-bell">
                            <a href="@Url.Action("Index", "Leave")" class="bell-icon" title="Leave Requests">
                                <i class="fas fa-bell"></i>
                                <span class="notification-badge" id="leaveNotificationBadge"></span>
                            </a>
                        </div>
                    }
                    
                    <div class="user-info">
                        <div class="user-avatar">
                            @(User.Identity?.Name?.Substring(0, 2).ToUpper() ?? "US")
                        </div>
                        <div class="user-details">
                            <span class="user-name">@User.Identity?.Name</span>
                            <span class="role-badge @(isAdmin ? "role-admin" : isHR ? "role-hr" : "role-employee")">@userRole</span>
                        </div>
                    </div>

                    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Landing", new { area = "" })" method="post">
                        <button type="submit" class="btn-logout">Logout</button>
                    </form>
                </div>
            </header>

            <!-- Content -->
            <main class="dashboard-content">
                @RenderBody()
            </main>

            <!-- Toast Notifications -->
            <partial name="_ToastNotification" />

            <!-- Footer -->
            <footer class="dashboard-footer">
                &copy; 2025 FiroTech. All rights reserved.
            </footer>
        </div>
    }
    else
    {
        <!-- For non-authenticated users (Login/Register pages) -->
        <div class="auth-page">
            @RenderBody()
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (SignInManager.IsSignedIn(User))
    {
        <script>
            // Mobile menu toggle
            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const sidebar = document.getElementById('sidebar');
            const sidebarOverlay = document.getElementById('sidebarOverlay');

            mobileMenuBtn?.addEventListener('click', () => {
                sidebar.classList.toggle('active');
                sidebarOverlay.classList.toggle('active');
            });

            sidebarOverlay?.addEventListener('click', () => {
                sidebar.classList.remove('active');
                sidebarOverlay.classList.remove('active');
            });

            // Fetch pending leave requests count (for Admin/HR)
            const isAdminOrHR = @(isAdminOrHR.ToString().ToLower());
            
            if (isAdminOrHR) {
                function updateLeaveNotifications() {
                    fetch('/api/GetPendingLeavesCount')
                        .then(response => response.json())
                        .then(data => {
                            const badge = document.getElementById('leaveNotificationBadge');
                            if (badge && data.count > 0) {
                                badge.textContent = data.count;
                                badge.classList.add('active');
                            } else if (badge) {
                                badge.classList.remove('active');
                            }
                        })
                        .catch(error => console.error('Error fetching notifications:', error));
                }

                // Update on page load
                updateLeaveNotifications();

                // Update every 30 seconds
                setInterval(updateLeaveNotifications, 30000);
            }

            // Master Data dropdown state persistence
            const masterDataMenu = document.getElementById('masterDataMenu');
            const masterDataToggle = document.querySelector('[href="#masterDataMenu"]');
            
            // Check if any master data page is active
            const currentController = '@ViewContext.RouteData.Values["controller"]';
            const masterDataControllers = ['Department', 'Designation', 'Shift'];
            
            if (masterDataControllers.includes(currentController)) {
                // Keep dropdown open if on master data page
                masterDataMenu?.classList.add('show');
                masterDataToggle?.setAttribute('aria-expanded', 'true');
            }
            
            // Save state to sessionStorage
            masterDataToggle?.addEventListener('click', function() {
                setTimeout(() => {
                    const isExpanded = masterDataMenu?.classList.contains('show');
                    sessionStorage.setItem('masterDataMenuOpen', isExpanded);
                }, 300);
            });
            
            // Restore state on page load
            if (sessionStorage.getItem('masterDataMenuOpen') === 'true' && !masterDataControllers.includes(currentController)) {
                masterDataMenu?.classList.add('show');
                masterDataToggle?.setAttribute('aria-expanded', 'true');
            }
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>