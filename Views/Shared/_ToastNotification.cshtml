<!-- Toast Notification Container -->
<div class="toast-container" id="toastContainer"></div>

<style>
    .toast-container {
        position: fixed;
        top: 90px;
        right: 30px;
        z-index: 9999;
        max-width: 400px;
    }

    .toast {
        background: white;
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 12px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
        display: flex;
        align-items: flex-start;
        gap: 12px;
        animation: slideInRight 0.3s ease-out;
        border-left: 4px solid;
    }

    .toast.success {
        border-left-color: #10b981;
    }

    .toast.error {
        border-left-color: #ef4444;
    }

    .toast.info {
        border-left-color: #2193b0;
    }

    .toast.warning {
        border-left-color: #f59e0b;
    }

    .toast-icon {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .toast.success .toast-icon {
        background: #d1f4e0;
        color: #10b981;
    }

    .toast.error .toast-icon {
        background: #fee2e2;
        color: #ef4444;
    }

    .toast.info .toast-icon {
        background: #e8f4f8;
        color: #2193b0;
    }

    .toast.warning .toast-icon {
        background: #fef3cd;
        color: #f59e0b;
    }

    .toast-content {
        flex: 1;
    }

    .toast-title {
        font-weight: 600;
        font-size: 14px;
        color: #2c3e50;
        margin-bottom: 4px;
    }

    .toast-message {
        font-size: 13px;
        color: #5a6c7d;
        line-height: 1.4;
    }

    .toast-close {
        background: none;
        border: none;
        color: #5a6c7d;
        cursor: pointer;
        opacity: 0.6;
        padding: 0;
        width: 20px;
        height: 20px;
        flex-shrink: 0;
        transition: opacity 0.3s;
    }

    .toast-close:hover {
        opacity: 1;
    }

    @@keyframes slideInRight {
        from {
            transform: translateX(400px);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @@keyframes slideOutRight {
        from {
            transform: translateX(0);
            opacity: 1;
        }
        to {
            transform: translateX(400px);
            opacity: 0;
        }
    }

    .toast.hiding {
        animation: slideOutRight 0.3s ease-out forwards;
    }

    @@media (max-width: 768px) {
        .toast-container {
            right: 20px;
            left: 20px;
            max-width: none;
        }
    }
</style>

<script>
    // Toast Notification System
    const ToastNotification = {
        show: function(title, message, type = 'info', duration = 5000) {
            const container = document.getElementById('toastContainer');
            if (!container) return;

            const toast = document.createElement('div');
            toast.className = `toast ${type}`;

            const icon = this.getIcon(type);
            
            toast.innerHTML = `
                <div class="toast-icon">
                    <i class="fas ${icon}"></i>
                </div>
                <div class="toast-content">
                    <div class="toast-title">${title}</div>
                    <div class="toast-message">${message}</div>
                </div>
                <button class="toast-close" onclick="ToastNotification.hide(this)">
                    <i class="fas fa-times"></i>
                </button>
            `;

            container.appendChild(toast);

            // Auto-hide after duration
            setTimeout(() => {
                this.hide(toast.querySelector('.toast-close'));
            }, duration);
        },

        hide: function(button) {
            const toast = button.closest('.toast');
            if (!toast) return;

            toast.classList.add('hiding');
            setTimeout(() => {
                toast.remove();
            }, 300);
        },

        getIcon: function(type) {
            switch(type) {
                case 'success': return 'fa-check-circle';
                case 'error': return 'fa-exclamation-circle';
                case 'warning': return 'fa-exclamation-triangle';
                case 'info': return 'fa-info-circle';
                default: return 'fa-info-circle';
            }
        },

        success: function(title, message, duration = 5000) {
            this.show(title, message, 'success', duration);
        },

        error: function(title, message, duration = 5000) {
            this.show(title, message, 'error', duration);
        },

        warning: function(title, message, duration = 5000) {
            this.show(title, message, 'warning', duration);
        },

        info: function(title, message, duration = 5000) {
            this.show(title, message, 'info', duration);
        }
    };

    // Global function for easy access
    window.showToast = ToastNotification.show.bind(ToastNotification);
</script>
