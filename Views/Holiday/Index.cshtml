@model IEnumerable<PayRollManagementSystem.Models.Holiday>

@{
    ViewData["Title"] = "Holiday Management";
    var selectedYear = (int)ViewData["SelectedYear"];
    var weekendSetting = ViewBag.WeekendSetting as PayRollManagementSystem.Models.WeekendSetting;
}

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .page-title {
        font-size: 28px;
        font-weight: 600;
        color: #2c3e50;
        margin: 0;
    }

    .header-actions {
        display: flex;
        gap: 10px;
    }

    .btn-primary {
        padding: 12px 24px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s;
    }

    .btn-secondary {
        padding: 12px 24px;
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        border: none;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s;
    }

    .btn-success {
        padding: 10px 20px;
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
    }

    .info-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .info-card {
        background: white;
        border-radius: 12px;
        padding: 25px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        border-left: 4px solid #667eea;
    }

    .info-card.weekend {
        border-left-color: #f5576c;
    }

    .info-card h3 {
        font-size: 14px;
        color: #5a6c7d;
        margin: 0 0 10px 0;
    }

    .info-card .value {
        font-size: 24px;
        font-weight: 700;
        color: #2c3e50;
    }

    .year-selector {
        background: white;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .year-selector select {
        padding: 10px 20px;
        border: 2px solid #e8f4f8;
        border-radius: 8px;
        font-size: 16px;
    }

    .holidays-table {
        background: white;
        border-radius: 12px;
        padding: 25px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead {
        background: #f8fafb;
    }

    th {
        padding: 15px;
        text-align: left;
        font-weight: 600;
        color: #2c3e50;
        border-bottom: 2px solid #e8f4f8;
    }

    td {
        padding: 15px;
        border-bottom: 1px solid #f8fafb;
        color: #5a6c7d;
    }

    tbody tr:hover {
        background: #f8fafb;
    }

    .badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .badge-national { background: rgba(99, 102, 241, 0.1); color: #6366f1; }
    .badge-religious { background: rgba(168, 85, 247, 0.1); color: #a855f7; }
    .badge-public { background: rgba(59, 130, 246, 0.1); color: #3b82f6; }
    .badge-company { background: rgba(16, 185, 129, 0.1); color: #10b981; }

    .action-btns {
        display: flex;
        gap: 8px;
    }

    .btn-edit {
        padding: 6px 12px;
        background: rgba(59, 130, 246, 0.1);
        color: #3b82f6;
        border-radius: 6px;
        text-decoration: none;
        font-size: 12px;
    }

    .btn-delete {
        padding: 6px 12px;
        background: rgba(239, 68, 68, 0.1);
        color: #ef4444;
        border-radius: 6px;
        text-decoration: none;
        font-size: 12px;
    }
</style>

<div class="page-header">
    <h1 class="page-title">&#128197; Holiday & Weekend Management</h1>
    <div class="header-actions">
        <a asp-action="WeekendSettings" class="btn-secondary">&#9881; Weekend Settings</a>
        <a asp-action="Create" class="btn-primary">&#10133; Add Holiday</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning">@TempData["Warning"]</div>
}

<!-- Info Cards -->
<div class="info-cards">
    <div class="info-card">
        <h3>Total Holidays (@selectedYear)</h3>
        <div class="value">@Model.Count()</div>
    </div>
    <div class="info-card weekend">
        <h3>Weekend Days</h3>
        <div class="value" style="font-size: 16px;">
            @if (weekendSetting != null)
            {
                @weekendSetting.GetWeekendDaysDisplay()
            }
            else
            {
                <span>Not configured</span>
            }
        </div>
    </div>
    <div class="info-card">
        <h3>National Holidays</h3>
        <div class="value">@Model.Count(h => h.Type == PayRollManagementSystem.Models.HolidayType.National)</div>
    </div>
    <div class="info-card">
        <h3>Religious Holidays</h3>
        <div class="value">@Model.Count(h => h.Type == PayRollManagementSystem.Models.HolidayType.Religious)</div>
    </div>
</div>

<!-- Year Selector -->
<div class="year-selector">
    <form method="get" asp-action="Index" style="display: flex; gap: 15px; align-items: center;">
        <label style="font-weight: 600; color: #2c3e50;">Select Year:</label>
        <select name="year" onchange="this.form.submit()" class="form-control" style="width: auto;">
            @for (int i = DateTime.Now.Year + 2; i >= DateTime.Now.Year - 5; i--)
            {
                <option value="@i" selected="@(i == selectedYear)">@i</option>
            }
        </select>
    </form>
    
    <form method="post" asp-action="BulkImport" onsubmit="return confirm('Import default Bangladeshi holidays for @selectedYear?');">
        @Html.AntiForgeryToken()
        <input type="hidden" name="year" value="@selectedYear" />
        <button type="submit" class="btn-success">&#128229; Import Default Holidays</button>
    </form>
</div>

<!-- Holidays Table -->
<div class="holidays-table">
    <table>
        <thead>
            <tr>
                <th>Holiday Name</th>
                <th>Date</th>
                <th>Day</th>
                <th>Type</th>
                <th>Description</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var holiday in Model)
                {
                    <tr>
                        <td><strong>@holiday.Name</strong></td>
                        <td>@holiday.Date.ToString("dd MMM yyyy")</td>
                        <td>@holiday.Date.DayOfWeek</td>
                        <td>
                            @{
                                var badgeClass = holiday.Type switch
                                {
                                    PayRollManagementSystem.Models.HolidayType.National => "badge-national",
                                    PayRollManagementSystem.Models.HolidayType.Religious => "badge-religious",
                                    PayRollManagementSystem.Models.HolidayType.Public => "badge-public",
                                    _ => "badge-company"
                                };
                            }
                            <span class="badge @badgeClass">@holiday.Type</span>
                        </td>
                        <td>@(holiday.Description ?? "-")</td>
                        <td>
                            @if (holiday.IsActive)
                            {
                                <span class="badge" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">Active</span>
                            }
                            else
                            {
                                <span class="badge" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="action-btns">
                                <a asp-action="Edit" asp-route-id="@holiday.HolidayId" class="btn-edit">&#9998; Edit</a>
                                <a asp-action="Delete" asp-route-id="@holiday.HolidayId" class="btn-delete">&#128465; Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" style="text-align: center; padding: 40px; color: #5a6c7d;">
                        <h3>No holidays found for @selectedYear</h3>
                        <p>Click "Import Default Holidays" to add Bangladeshi public holidays</p>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
