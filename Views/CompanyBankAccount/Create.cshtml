@model PayRollManagementSystem.Models.CompanyBankAccount

@{
    ViewData["Title"] = "Add Company Bank Account";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="fas fa-plus-circle text-primary"></i> Add Company Bank Account
            </h2>
            <p class="text-muted mb-0">Create a new company bank account for salary payments</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Account Information -->
                        <div class="border-start border-primary border-3 ps-3 mb-4">
                            <h5 class="mb-3">
                                <i class="fas fa-info-circle text-primary"></i> Account Information
                            </h5>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="AccountName" class="form-label"></label>
                                    <input asp-for="AccountName" class="form-control" placeholder="e.g., Main Payroll Account" />
                                    <span asp-validation-for="AccountName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="AccountType" class="form-label"></label>
                                    <select asp-for="AccountType" class="form-select" asp-items="Html.GetEnumSelectList<PayRollManagementSystem.Models.CompanyAccountType>()">
                                        <option value="">-- Select Account Type --</option>
                                    </select>
                                    <span asp-validation-for="AccountType" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Bank Details -->
                        <div class="border-start border-info border-3 ps-3 mb-4">
                            <h5 class="mb-3">
                                <i class="fas fa-building text-info"></i> Bank Details
                            </h5>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="BankName" class="form-label"></label>
                                    <input asp-for="BankName" class="form-control" placeholder="e.g., Islami Bank Bangladesh" />
                                    <span asp-validation-for="BankName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="BranchName" class="form-label"></label>
                                    <input asp-for="BranchName" class="form-control" placeholder="e.g., Gulshan Branch" />
                                    <span asp-validation-for="BranchName" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="AccountNumber" class="form-label"></label>
                                    <input asp-for="AccountNumber" class="form-control" placeholder="Enter account number" />
                                    <span asp-validation-for="AccountNumber" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="RoutingNumber" class="form-label"></label>
                                    <input asp-for="RoutingNumber" class="form-control" placeholder="Enter routing number (optional)" />
                                    <span asp-validation-for="RoutingNumber" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="SwiftCode" class="form-label"></label>
                                    <input asp-for="SwiftCode" class="form-control" placeholder="SWIFT/BIC code (optional)" />
                                    <span asp-validation-for="SwiftCode" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Balance & Status -->
                        <div class="border-start border-success border-3 ps-3 mb-4">
                            <h5 class="mb-3">
                                <i class="fas fa-cog text-success"></i> Settings
                            </h5>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="AvailableBalance" class="form-label"></label>
                                    <input asp-for="AvailableBalance" class="form-control" type="number" step="0.01" placeholder="0.00" />
                                    <small class="text-muted d-block mt-1">
                                        <i class="fas fa-bolt text-warning"></i> Balance will automatically reduce when payments complete
                                    </small>
                                    <span asp-validation-for="AvailableBalance" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Status" class="form-label"></label>
                                    <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<PayRollManagementSystem.Models.BankAccountStatus>()">
                                        <option value="">-- Select Status --</option>
                                    </select>
                                    <span asp-validation-for="Status" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="form-check">
                                    <input asp-for="IsPrimary" class="form-check-input" />
                                    <label asp-for="IsPrimary" class="form-check-label"></label>
                                </div>
                                <small class="text-muted">Primary account will be selected by default when processing payments</small>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label"></label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter description or notes (optional)"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Create Account
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Tips Card -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-gradient text-white border-0" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h6 class="mb-0">
                        <i class="fas fa-lightbulb"></i> Tips & Guidelines
                    </h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6 class="text-primary">
                            <i class="fas fa-star"></i> Primary Account
                        </h6>
                        <p class="small text-muted mb-0">The primary account will be automatically selected when processing salary payments.</p>
                    </div>
                    <hr />
                    <div class="mb-3">
                        <h6 class="text-success">
                            <i class="fas fa-money-bill-wave"></i> Available Balance
                        </h6>
                        <p class="small text-muted mb-0">Enter your current account balance. It will automatically reduce when you process payments.</p>
                    </div>
                    <hr />
                    <div class="mb-0">
                        <h6 class="text-info">
                            <i class="fas fa-shield-alt"></i> Account Status
                        </h6>
                        <ul class="small text-muted mb-0 ps-3">
                            <li><strong>Active:</strong> Can be used for payments</li>
                            <li><strong>Inactive:</strong> Not available for payments</li>
                            <li><strong>Suspended:</strong> Temporarily disabled</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Example Card -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-success text-white border-0">
                    <h6 class="mb-0">
                        <i class="fas fa-check-circle"></i> Example
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="small">Initial Balance:</span>
                        <strong class="small">1,000,000.00</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="small">Employee Salary:</span>
                        <strong class="small text-danger">-50,000.00</strong>
                    </div>
                    <hr class="my-2" />
                    <div class="d-flex justify-content-between">
                        <span class="small">After Payment:</span>
                        <strong class="text-success">950,000.00</strong>
                    </div>
                    <small class="text-muted d-block mt-2">
                        <i class="fas fa-info-circle"></i> Balance automatically reduced!
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
