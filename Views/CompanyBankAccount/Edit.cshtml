@model PayRollManagementSystem.Models.CompanyBankAccount

@{
    ViewData["Title"] = "Edit Company Bank Account";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="fas fa-edit text-primary"></i> Edit Company Bank Account
            </h2>
            <p class="text-muted mb-0">Update bank account information</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <input type="hidden" asp-for="CompanyBankAccountId" />
                        <input type="hidden" asp-for="CreatedAt" />

                        <!-- Account Information -->
                        <div class="border-start border-primary border-3 ps-3 mb-4">
                            <h5 class="mb-3">
                                <i class="fas fa-info-circle text-primary"></i> Account Information
                            </h5>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="AccountName" class="form-label"></label>
                                    <input asp-for="AccountName" class="form-control" />
                                    <span asp-validation-for="AccountName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="AccountType" class="form-label"></label>
                                    <select asp-for="AccountType" class="form-select" asp-items="Html.GetEnumSelectList<PayRollManagementSystem.Models.CompanyAccountType>()"></select>
                                    <span asp-validation-for="AccountType" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Bank Details -->
                        <div class="border-start border-info border-3 ps-3 mb-4">
                            <h5 class="mb-3">
                                <i class="fas fa-building text-info"></i> Bank Details
                            </h5>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="BankName" class="form-label"></label>
                                    <input asp-for="BankName" class="form-control" />
                                    <span asp-validation-for="BankName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="BranchName" class="form-label"></label>
                                    <input asp-for="BranchName" class="form-control" />
                                    <span asp-validation-for="BranchName" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="AccountNumber" class="form-label"></label>
                                    <input asp-for="AccountNumber" class="form-control" />
                                    <span asp-validation-for="AccountNumber" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="RoutingNumber" class="form-label"></label>
                                    <input asp-for="RoutingNumber" class="form-control" />
                                    <span asp-validation-for="RoutingNumber" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="SwiftCode" class="form-label"></label>
                                    <input asp-for="SwiftCode" class="form-control" />
                                    <span asp-validation-for="SwiftCode" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Balance & Status -->
                        <div class="border-start border-success border-3 ps-3 mb-4">
                            <h5 class="mb-3">
                                <i class="fas fa-cog text-success"></i> Settings
                            </h5>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="AvailableBalance" class="form-label"></label>
                                    <input asp-for="AvailableBalance" class="form-control" type="number" step="0.01" />
                                    <small class="text-muted d-block mt-1">
                                        <i class="fas fa-bolt text-warning"></i> Balance automatically reduces on payment completion
                                    </small>
                                    <small class="text-warning d-block mt-1">
                                        <i class="fas fa-exclamation-triangle"></i> Manual adjustment will be logged
                                    </small>
                                    <span asp-validation-for="AvailableBalance" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Status" class="form-label"></label>
                                    <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<PayRollManagementSystem.Models.BankAccountStatus>()"></select>
                                    <span asp-validation-for="Status" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="form-check">
                                    <input asp-for="IsPrimary" class="form-check-input" />
                                    <label asp-for="IsPrimary" class="form-check-label"></label>
                                </div>
                                <small class="text-muted">Primary account will be selected by default when processing payments</small>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label"></label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Account Info -->
                        <div class="alert alert-light border">
                            <small class="text-muted">
                                <i class="fas fa-clock"></i>
                                <strong>Created:</strong> @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                                @if (Model.UpdatedAt.HasValue)
                                {
                                    <br />
                                    <i class="fas fa-history"></i>
                                    <strong>Last Updated:</strong> @Model.UpdatedAt.Value.ToString("dd MMM yyyy, hh:mm tt")
                                }
                            </small>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Save Changes
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.CompanyBankAccountId" class="btn btn-outline-info">
                                <i class="fas fa-eye"></i> View Details
                            </a>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Important Notes -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-warning text-dark border-0">
                    <h6 class="mb-0">
                        <i class="fas fa-exclamation-triangle"></i> Important Notes
                    </h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6 class="text-primary">
                            <i class="fas fa-shield-alt"></i> Account Number
                        </h6>
                        <p class="small text-muted mb-0">Changing the account number will not affect existing payment transactions.</p>
                    </div>
                    <hr />
                    <div class="mb-3">
                        <h6 class="text-success">
                            <i class="fas fa-money-bill-wave"></i> Balance Adjustment
                        </h6>
                        <p class="small text-muted mb-0">You can manually adjust the balance if needed. Any changes will be logged.</p>
                    </div>
                    <hr />
                    <div class="mb-0">
                        <h6 class="text-warning">
                            <i class="fas fa-star"></i> Primary Account
                        </h6>
                        <p class="small text-muted mb-0">Only one account can be set as primary. Setting this as primary will remove the primary flag from other accounts.</p>
                    </div>
                </div>
            </div>

            <!-- Status Guide -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-info text-white border-0">
                    <h6 class="mb-0">
                        <i class="fas fa-info-circle"></i> Status Guide
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge bg-success me-2">Active</span>
                        <small class="text-muted">Available for payments</small>
                    </div>
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge bg-secondary me-2">Inactive</span>
                        <small class="text-muted">Not available for payments</small>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="badge bg-danger me-2">Suspended</span>
                        <small class="text-muted">Temporarily disabled</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
