@model PayRollManagementSystem.Models.Employee

@{
    ViewData["Title"] = "Edit Profile";
    Layout = "~/Views/Shared/_EmployeePortalLayout.cshtml";
}

<style>
    .profile-edit-container {
        max-width: 800px;
        margin: 0 auto;
    }

    .profile-card {
        background: white;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 2px 15px rgba(52, 152, 219, 0.08);
        margin-bottom: 20px;
    }

    .card-title {
        font-size: 20px;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 2px solid #e8f4f8;
    }

    .profile-image-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 30px;
        background: #f8fafb;
        border-radius: 12px;
        margin-bottom: 30px;
    }

    .current-profile-image {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #6dd5ed;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(33, 147, 176, 0.2);
    }

    .default-profile-icon {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        background: linear-gradient(135deg, #6dd5ed 0%, #2193b0 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 60px;
        color: white;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(33, 147, 176, 0.2);
    }

    .upload-btn-wrapper {
        position: relative;
        overflow: hidden;
        display: inline-block;
    }

    .upload-btn {
        padding: 12px 30px;
        background: linear-gradient(135deg, #6dd5ed 0%, #2193b0 100%);
        color: white;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 4px 12px rgba(33, 147, 176, 0.3);
    }

    .upload-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(33, 147, 176, 0.4);
    }

    .upload-btn-wrapper input[type=file] {
        font-size: 100px;
        position: absolute;
        left: 0;
        top: 0;
        opacity: 0;
        cursor: pointer;
    }

    .file-name {
        margin-top: 15px;
        color: #5a6c7d;
        font-size: 14px;
        font-style: italic;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .form-group {
        margin-bottom: 0;
    }

    .form-group label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 8px;
    }

    .form-control {
        width: 100%;
        padding: 12px 15px;
        border: 2px solid #e8f4f8;
        border-radius: 8px;
        font-size: 14px;
        transition: all 0.3s;
    }

    .form-control:focus {
        border-color: #6dd5ed;
        box-shadow: 0 0 0 3px rgba(109, 213, 237, 0.1);
        outline: none;
    }

    textarea.form-control {
        resize: vertical;
        min-height: 100px;
    }

    .readonly-field {
        background: #f8fafb;
        cursor: not-allowed;
    }

    .form-actions {
        display: flex;
        gap: 15px;
        justify-content: flex-end;
        margin-top: 30px;
        padding-top: 20px;
        border-top: 2px solid #e8f4f8;
    }

    .btn-cancel {
        padding: 12px 30px;
        background: #e8f4f8;
        color: #2193b0;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s;
    }

    .btn-cancel:hover {
        background: #d1e9f0;
    }

    .btn-submit {
        padding: 12px 30px;
        background: linear-gradient(135deg, #6dd5ed 0%, #2193b0 100%);
        color: white;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 4px 12px rgba(33, 147, 176, 0.3);
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(33, 147, 176, 0.4);
    }

    .help-text {
        font-size: 12px;
        color: #5a6c7d;
        margin-top: 5px;
    }
</style>

<div class="profile-edit-container">
    <div class="profile-card">
        <h2 class="card-title"><i class="fas fa-user-edit"></i> Edit Profile</h2>

        <form asp-action="EditProfile" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="EmployeeId" />

            <!-- Profile Image Upload Section -->
            <div class="profile-image-section">
                @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
                {
                    <img src="@Model.ProfileImagePath" alt="Profile" class="current-profile-image" id="profilePreview" />
                }
                else
                {
                    <div class="default-profile-icon" id="defaultIcon">
                        <i class="fas fa-user"></i>
                    </div>
                    <img src="#" alt="Profile Preview" class="current-profile-image" id="profilePreview" style="display: none;" />
                }
                
                <div class="upload-btn-wrapper">
                    <button type="button" class="upload-btn">
                        <i class="fas fa-camera"></i> Choose Profile Photo
                    </button>
                    <input type="file" name="profileImage" id="profileImage" accept="image/*" />
                </div>
                <p class="file-name" id="fileName">No file chosen</p>
                <p class="help-text">Recommended: Square image, max 5MB (JPG, PNG, GIF)</p>
            </div>

            <!-- Personal Information -->
            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="Name">Full Name</label>
                    <input asp-for="Name" class="form-control readonly-field" readonly />
                </div>

                <div class="form-group">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" class="form-control readonly-field" readonly />
                </div>

                <div class="form-group">
                    <label asp-for="Phone">Phone Number <span style="color: #ef4444;">*</span></label>
                    <input asp-for="Phone" class="form-control" placeholder="Enter your phone number" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Address">Address</label>
                    <textarea asp-for="Address" class="form-control" placeholder="Enter your address"></textarea>
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="City">City</label>
                    <input asp-for="City" class="form-control" placeholder="Enter your city" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
            </div>

            <div class="form-actions">
                <a asp-action="Profile" class="btn-cancel">Cancel</a>
                <button type="submit" class="btn-submit">
                    <i class="fas fa-save"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    
    <script>
        // Profile image preview
        document.getElementById('profileImage').addEventListener('change', function(e) {
            const file = e.target.files[0];
            const fileName = document.getElementById('fileName');
            const preview = document.getElementById('profilePreview');
            const defaultIcon = document.getElementById('defaultIcon');
            
            if (file) {
                // Show file name
                fileName.textContent = file.name;
                
                // Validate file size (5MB)
                if (file.size > 5 * 1024 * 1024) {
                    alert('File size must be less than 5MB');
                    e.target.value = '';
                    fileName.textContent = 'No file chosen';
                    return;
                }
                
                // Show preview
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                    if (defaultIcon) {
                        defaultIcon.style.display = 'none';
                    }
                }
                reader.readAsDataURL(file);
            } else {
                fileName.textContent = 'No file chosen';
            }
        });
    </script>
}
