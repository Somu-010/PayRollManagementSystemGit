@model PayRollManagementSystem.Models.Leave

@{
    ViewData["Title"] = "Apply Leave";
    Layout = "~/Views/Shared/_EmployeePortalLayout.cshtml";
    var employee = ViewBag.Employee as PayRollManagementSystem.Models.Employee;
    var leaveBalance = ViewBag.LeaveBalance as PayRollManagementSystem.Models.LeaveBalance;
    var isFemale = employee?.Gender == PayRollManagementSystem.Models.Gender.Female;
}

<style>
    .apply-leave-container {
        max-width: 700px;
        margin: 0 auto;
    }

    .form-card {
        background: white;
        border-radius: 16px;
        padding: 40px;
        box-shadow: 0 2px 15px rgba(0, 0, 0, 0.08);
    }

    .form-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .form-header h2 {
        font-size: 24px;
        color: #2c3e50;
        margin-bottom: 10px;
    }

    .form-header p {
        color: #5a6c7d;
        font-size: 14px;
    }

    .leave-balance-preview {
        background: linear-gradient(135deg, #6dd5ed 0%, #2193b0 100%);
        border-radius: 12px;
        padding: 20px;
        color: white;
        margin-bottom: 30px;
        display: grid;
        grid-template-columns: repeat(@(isFemale ? 4 : 3), 1fr);
        gap: 15px;
        text-align: center;
    }

    .balance-item {
        position: relative;
    }

    .balance-item .value {
        font-size: 24px;
        font-weight: 700;
    }

    .balance-item .label {
        font-size: 11px;
        opacity: 0.9;
        margin-top: 5px;
    }

    .balance-item.low-balance .value {
        color: #ffd93d;
    }

    .balance-item.no-balance .value {
        color: #ff6b6b;
    }

    .form-group {
        margin-bottom: 25px;
    }

    .form-group label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 8px;
    }

    .form-group label .required {
        color: #ef4444;
    }

    .form-control {
        width: 100%;
        padding: 12px 15px;
        border: 2px solid #e8e8e8;
        border-radius: 10px;
        font-size: 14px;
        transition: all 0.3s;
    }

    .form-control:focus {
        outline: none;
        border-color: #2193b0;
        box-shadow: 0 0 0 3px rgba(33, 147, 176, 0.1);
    }

    .form-control.is-invalid {
        border-color: #ef4444;
    }

    .text-danger {
        color: #ef4444;
        font-size: 12px;
        margin-top: 5px;
    }

    .form-row {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .checkbox-group {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 10px;
    }

    .checkbox-group input[type="checkbox"] {
        width: 20px;
        height: 20px;
        accent-color: #2193b0;
    }

    .checkbox-group label {
        margin: 0;
        font-weight: 500;
    }

    .form-actions {
        display: flex;
        gap: 15px;
        margin-top: 30px;
    }

    .btn {
        padding: 14px 30px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.3s;
        border: none;
        text-decoration: none;
        text-align: center;
    }

    .btn-submit {
        flex: 1;
        background: linear-gradient(135deg, #6dd5ed 0%, #2193b0 100%);
        color: white;
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 20px rgba(33, 147, 176, 0.4);
    }

    .btn-cancel {
        padding: 14px 30px;
        background: #f1f3f5;
        color: #5a6c7d;
    }

    .btn-cancel:hover {
        background: #e8e8e8;
        color: #2c3e50;
    }

    .info-box {
        background: #f8fafb;
        border-left: 4px solid #2193b0;
        padding: 15px;
        border-radius: 0 8px 8px 0;
        margin-bottom: 25px;
    }

    .info-box h4 {
        font-size: 14px;
        color: #2c3e50;
        margin-bottom: 8px;
    }

    .info-box p {
        font-size: 13px;
        color: #5a6c7d;
        margin: 0;
    }

    .alert {
        padding: 12px 15px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .alert-warning {
        background: rgba(255, 193, 7, 0.1);
        border: 2px solid rgba(255, 193, 7, 0.3);
        color: #856404;
    }

    .alert-danger {
        background: rgba(239, 68, 68, 0.1);
        border: 2px solid rgba(239, 68, 68, 0.3);
        color: #dc3545;
    }

    #balanceWarning {
        display: none;
    }

    @@media (max-width: 768px) {
        .form-row {
            grid-template-columns: 1fr;
        }

        .leave-balance-preview {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>

<div class="apply-leave-container">
    <div class="form-card">
        <div class="form-header">
            <h2><i class="fas fa-plane-departure"></i> Apply for Leave</h2>
            <p>Fill in the details below to submit your leave request</p>
        </div>

        @if (leaveBalance != null)
        {
            <div class="leave-balance-preview">
                <div class="balance-item @(leaveBalance.RemainingAnnualLeave < 5 ? (leaveBalance.RemainingAnnualLeave == 0 ? "no-balance" : "low-balance") : "")">
                    <div class="value">@leaveBalance.RemainingAnnualLeave</div>
                    <div class="label">Annual Leave</div>
                </div>
                <div class="balance-item @(leaveBalance.RemainingSickLeave < 3 ? (leaveBalance.RemainingSickLeave == 0 ? "no-balance" : "low-balance") : "")">
                    <div class="value">@leaveBalance.RemainingSickLeave</div>
                    <div class="label">Sick Leave</div>
                </div>
                <div class="balance-item @(leaveBalance.RemainingCasualLeave < 3 ? (leaveBalance.RemainingCasualLeave == 0 ? "no-balance" : "low-balance") : "")">
                    <div class="value">@leaveBalance.RemainingCasualLeave</div>
                    <div class="label">Casual Leave</div>
                </div>
                @if (isFemale)
                {
                    <div class="balance-item @(leaveBalance.RemainingMaternityLeave < 30 ? (leaveBalance.RemainingMaternityLeave == 0 ? "no-balance" : "low-balance") : "")">
                        <div class="value">@leaveBalance.RemainingMaternityLeave</div>
                        <div class="label">Maternity Leave</div>
                    </div>
                }
            </div>
        }

        <form asp-action="ApplyLeave" method="post" id="leaveForm">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger alert alert-danger"></div>

            <div id="balanceWarning" class="alert alert-warning">
                <i class="fas fa-exclamation-triangle"></i> <span id="balanceWarningText"></span>
            </div>

            <div class="form-group">
                <label asp-for="LeaveType">Leave Type <span class="required">*</span></label>
                <select asp-for="LeaveType" class="form-control" id="leaveTypeSelect" required>
                    <option value="">-- Select Leave Type --</option>
                    <option value="AnnualLeave">Annual Leave</option>
                    <option value="SickLeave">Sick Leave</option>
                    <option value="CasualLeave">Casual Leave</option>
                    @if (isFemale)
                    {
                        <option value="MaternityLeave">Maternity Leave</option>
                    }
                    <option value="UnpaidLeave">Unpaid Leave</option>
                </select>
                <span asp-validation-for="LeaveType" class="text-danger"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="StartDate">Start Date <span class="required">*</span></label>
                    <input asp-for="StartDate" type="date" class="form-control" id="startDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="EndDate">End Date <span class="required">*</span></label>
                    <input asp-for="EndDate" type="date" class="form-control" id="endDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
            </div>

            <div class="checkbox-group">
                <input asp-for="IsHalfDay" type="checkbox" id="isHalfDay" />
                <label asp-for="IsHalfDay">Half Day Leave</label>
            </div>

            <div class="form-group" style="margin-top: 25px;">
                <label asp-for="Reason">Reason <span class="required">*</span></label>
                <textarea asp-for="Reason" class="form-control" rows="4" placeholder="Please provide a reason for your leave request..." required></textarea>
                <span asp-validation-for="Reason" class="text-danger"></span>
            </div>

            <div class="info-box">
                <h4><i class="fas fa-info-circle"></i> Important Notes</h4>
                <p>
                    • Leave requests must be submitted at least 1 day in advance for planned leave.<br>
                    • For sick leave, please submit supporting documents if requested.<br>
                    • Your leave balance will be updated once the request is approved.<br>
                    @if (!isFemale)
                    {
                        <strong style="color: #2193b0;">• Maternity leave is not available for your gender profile.</strong><br>
                    }
                </p>
            </div>

            <div class="form-actions">
                <a asp-action="LeaveRequests" class="btn btn-cancel">Cancel</a>
                <button type="submit" class="btn btn-submit" id="submitBtn">
                    <i class="fas fa-paper-plane"></i> Submit Request
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Leave balances from server
        const leaveBalances = {
            AnnualLeave: @(leaveBalance?.RemainingAnnualLeave ?? 0),
            SickLeave: @(leaveBalance?.RemainingSickLeave ?? 0),
            CasualLeave: @(leaveBalance?.RemainingCasualLeave ?? 0),
            MaternityLeave: @(leaveBalance?.RemainingMaternityLeave ?? 0),
            UnpaidLeave: 999 // No limit
        };

        const startDateInput = document.getElementById('startDate');
        const endDateInput = document.getElementById('endDate');
        const isHalfDayCheckbox = document.getElementById('isHalfDay');
        const leaveTypeSelect = document.getElementById('leaveTypeSelect');
        const balanceWarning = document.getElementById('balanceWarning');
        const balanceWarningText = document.getElementById('balanceWarningText');
        const submitBtn = document.getElementById('submitBtn');
        const leaveForm = document.getElementById('leaveForm');

        // Auto-set end date to start date when start date changes
        startDateInput.addEventListener('change', function() {
            if (!endDateInput.value || endDateInput.value < this.value) {
                endDateInput.value = this.value;
            }
            endDateInput.min = this.value;
            checkLeaveBalance();
        });

        // Check balance when end date changes
        endDateInput.addEventListener('change', checkLeaveBalance);

        // Check balance when half day checkbox changes
        isHalfDayCheckbox.addEventListener('change', checkLeaveBalance);

        // Check balance when leave type changes
        leaveTypeSelect.addEventListener('change', checkLeaveBalance);

        // Form submission validation
        leaveForm.addEventListener('submit', function(e) {
            if (!validateLeaveBalance()) {
                e.preventDefault();
                alert('Insufficient leave balance! Please check your available balance and try again.');
                return false;
            }
        });

        function calculateLeaveDays() {
            if (!startDateInput.value || !endDateInput.value) {
                return 0;
            }

            if (isHalfDayCheckbox.checked) {
                return 0.5;
            }

            const start = new Date(startDateInput.value);
            const end = new Date(endDateInput.value);
            const diffTime = Math.abs(end - start);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            return diffDays + 1; // Include both start and end date
        }

        function checkLeaveBalance() {
            const leaveType = leaveTypeSelect.value;
            if (!leaveType || leaveType === '') {
                balanceWarning.style.display = 'none';
                return;
            }

            const requestedDays = calculateLeaveDays();
            const availableBalance = leaveBalances[leaveType] || 0;

            if (leaveType === 'UnpaidLeave') {
                balanceWarning.style.display = 'none';
                submitBtn.disabled = false;
                return;
            }

            if (requestedDays > availableBalance) {
                balanceWarning.className = 'alert alert-danger';
                balanceWarning.style.display = 'block';
                balanceWarningText.innerHTML = `<strong>Insufficient Balance!</strong> You are requesting ${requestedDays} days but only have ${availableBalance} days available for ${leaveType.replace(/([A-Z])/g, ' $1').trim()}.`;
                submitBtn.disabled = true;
            } else if (requestedDays > 0 && availableBalance - requestedDays < 3 && leaveType !== 'MaternityLeave') {
                balanceWarning.className = 'alert alert-warning';
                balanceWarning.style.display = 'block';
                balanceWarningText.innerHTML = `<strong>Low Balance Warning:</strong> After this leave, you will have ${(availableBalance - requestedDays).toFixed(1)} days remaining for ${leaveType.replace(/([A-Z])/g, ' $1').trim()}.`;
                submitBtn.disabled = false;
            } else {
                balanceWarning.style.display = 'none';
                submitBtn.disabled = false;
            }
        }

        function validateLeaveBalance() {
            const leaveType = leaveTypeSelect.value;
            if (!leaveType || leaveType === '' || leaveType === 'UnpaidLeave') {
                return true;
            }

            const requestedDays = calculateLeaveDays();
            const availableBalance = leaveBalances[leaveType] || 0;

            return requestedDays <= availableBalance;
        }
    </script>
}
