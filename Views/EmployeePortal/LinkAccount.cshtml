@{
    ViewData["Title"] = "Account Registration Required";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .registration-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        background: linear-gradient(135deg, #e8f4f8 0%, #f8fafb 100%);
    }

    .registration-card {
        background: white;
        border-radius: 20px;
        padding: 50px;
        max-width: 600px;
        width: 100%;
        box-shadow: 0 10px 40px rgba(33, 147, 176, 0.1);
        text-align: center;
    }

    .registration-icon {
        width: 120px;
        height: 120px;
        margin: 0 auto 30px;
        background: linear-gradient(135deg, #6dd5ed 0%, #2193b0 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 60px;
        color: white;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(33, 147, 176, 0.4);
        }
        50% {
            transform: scale(1.05);
            box-shadow: 0 0 0 20px rgba(33, 147, 176, 0);
        }
    }

    .registration-title {
        font-size: 32px;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 20px;
    }

    .registration-subtitle {
        font-size: 18px;
        color: #5a6c7d;
        margin-bottom: 30px;
        line-height: 1.6;
    }

    .info-box {
        background: #e8f4f8;
        border-left: 4px solid #2193b0;
        padding: 20px;
        border-radius: 10px;
        text-align: left;
        margin: 30px 0;
    }

    .info-box h4 {
        color: #2193b0;
        margin-bottom: 15px;
        font-size: 18px;
        font-weight: 600;
    }

    .info-box ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .info-box li {
        padding: 10px 0;
        color: #2c3e50;
        font-size: 15px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
    }

    .info-box li::before {
        content: "✓";
        color: #10b981;
        font-weight: bold;
        font-size: 18px;
        flex-shrink: 0;
    }

    .contact-section {
        margin-top: 30px;
        padding-top: 30px;
        border-top: 2px solid #e8f4f8;
    }

    .contact-section h4 {
        color: #2c3e50;
        margin-bottom: 15px;
        font-size: 20px;
    }

    .contact-info {
        display: flex;
        gap: 20px;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 20px;
    }

    .contact-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 20px;
        background: #f8fafb;
        border-radius: 10px;
        color: #2193b0;
        font-weight: 600;
    }

    .btn-logout {
        margin-top: 30px;
        padding: 15px 40px;
        background: linear-gradient(135deg, #6dd5ed 0%, #2193b0 100%);
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 4px 15px rgba(33, 147, 176, 0.3);
    }

    .btn-logout:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(33, 147, 176, 0.4);
    }
</style>

<div class="registration-container">
    <div class="registration-card">
        <div class="registration-icon">
            <i class="fas fa-user-lock"></i>
        </div>
        
        <h1 class="registration-title">Account Access Pending</h1>
        <p class="registration-subtitle">
            Thank you for registering! Your account has been created successfully, 
            but you don't have access to the Employee Portal yet.
        </p>

        <div class="info-box">
            <h4><i class="fas fa-info-circle"></i> What Happens Next?</h4>
            <ul>
                <li>Your account will be reviewed by the HR/Admin team</li>
                <li>Admin will link your account to your employee profile</li>
                <li>You'll receive an email confirmation once activated</li>
                <li>After activation, you can access the Employee Portal</li>
            </ul>
        </div>

        <div class="info-box" style="background: #fff3cd; border-left-color: #ffc107;">
            <h4 style="color: #856404;"><i class="fas fa-clock"></i> Expected Timeline</h4>
            <ul>
                <li style="color: #856404;">Account activation typically takes 1-2 business days</li>
                <li style="color: #856404;">You'll be notified via email at: <strong>@User.Identity?.Name</strong></li>
            </ul>
        </div>

        <div class="contact-section">
            <h4>Need Help?</h4>
            <p style="color: #5a6c7d; margin-bottom: 20px;">
                If you have any questions or need immediate assistance, please contact:
            </p>
            <div class="contact-info">
                <div class="contact-item">
                    <i class="fas fa-envelope"></i>
                    <span>hr@company.com</span>
                </div>
                <div class="contact-item">
                    <i class="fas fa-phone"></i>
                    <span>+880-XXX-XXXXX</span>
                </div>
            </div>
        </div>

        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Landing")" method="post">
            <button type="submit" class="btn-logout">
                <i class="fas fa-sign-out-alt"></i> Logout
            </button>
        </form>
    </div>
</div>
