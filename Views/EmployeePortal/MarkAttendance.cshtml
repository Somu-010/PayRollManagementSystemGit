@model PayRollManagementSystem.Models.Employee

@{
    /* ========================================
       PAGE: MARK ATTENDANCE
       Employee check-in/check-out page
       Handles daily attendance marking with validation
       ======================================== */
    ViewData["Title"] = "Mark Attendance";
    Layout = "~/Views/Shared/_EmployeePortalLayout.cshtml";
    
    /* Get today's attendance record if exists */
    var todayAttendance = ViewBag.TodayAttendance as PayRollManagementSystem.Models.Attendance;
    var currentTime = ViewBag.CurrentTime as string;
    
    /* Check if today is a working day */
    var isWorkingDay = ViewBag.IsWorkingDay != null ? (bool)ViewBag.IsWorkingDay : true;
    var holiday = ViewBag.Holiday as PayRollManagementSystem.Models.Holiday;
    var isWeekend = ViewBag.IsWeekend != null ? (bool)ViewBag.IsWeekend : false;
}

<style>
    /* ========================================
       MAIN CONTAINER
       Centered card layout for attendance marking
       ======================================== */
    .mark-attendance-container {
        max-width: 800px;
        margin: 0 auto;
        background: white;
        border-radius: 16px;
        padding: 40px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    /* ========================================
       HEADER SECTION
       Page title and description
       ======================================== */
    .header-section {
        text-align: center;
        margin-bottom: 40px;
    }

    .header-section h2 {
        color: #2c3e50;
        margin: 0 0 10px 0;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
    }

    .header-section p {
        color: #5a6c7d;
        margin: 0;
    }

    /* ========================================
       CURRENT TIME DISPLAY
       Large clock showing current time
       Change: background gradient for different color
       ======================================== */
    .current-time-display {
        /* BLUE GRADIENT - Change for different color */
        background: linear-gradient(135deg, #6dd5ed 0%, #2193b0 100%);
        color: white;
        padding: 30px;
        border-radius: 12px;
        text-align: center;
        margin-bottom: 30px;
    }

    .current-time-display .time {
        font-size: 48px;              /* Time size */
        font-weight: 700;
        margin-bottom: 5px;
    }

    .current-time-display .date {
        font-size: 16px;              /* Date size */
        opacity: 0.9;
    }

    /* ========================================
       EMPLOYEE INFO CARD
       Shows employee details before marking
       ======================================== */
    .employee-info-card {
        background: #f8fafb;           /* Light gray background */
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 30px;
    }

    .info-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
    }

    .info-item {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .info-item i {
        color: #2193b0;              /* Icon color */
        font-size: 18px;
        width: 24px;
    }

    .info-item .label {
        font-size: 12px;
        color: #5a6c7d;
        margin: 0;
    }

    .info-item .value {
        font-weight: 600;
        color: #2c3e50;
        margin: 0;
    }

    /* ========================================
       ACTION BUTTONS
       Check-in and Check-out buttons
       ======================================== */
    .action-buttons {
        display: flex;
        gap: 15px;
        justify-content: center;
        margin-bottom: 30px;
    }

    .btn-action {
        padding: 18px 40px;
        border: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 10px;
        transition: all 0.3s;
        min-width: 200px;
        justify-content: center;
    }

    /* Check-in button - Green gradient */
    .btn-checkin {
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        color: white;
    }

    .btn-checkin:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(67, 233, 123, 0.4);
    }

    /* Check-out button - Pink-yellow gradient */
    .btn-checkout {
        background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
        color: white;
    }

    .btn-checkout:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(250, 112, 154, 0.4);
    }

    .btn-action:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none !important;
    }

    /* ========================================
       ATTENDANCE STATUS CARD
       Shows today's attendance details
       ======================================== */
    .attendance-status-card {
        /* PURPLE GRADIENT */
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 25px;
        border-radius: 12px;
        margin-bottom: 20px;
    }

    .attendance-status-card h3 {
        margin: 0 0 15px 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .status-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 15px;
    }

    .status-item {
        background: rgba(255, 255, 255, 0.15);
        padding: 15px;
        border-radius: 8px;
        text-align: center;
    }

    .status-item .label {
        font-size: 12px;
        opacity: 0.9;
        margin-bottom: 5px;
    }

    .status-item .value {
        font-size: 20px;
        font-weight: 700;
    }

    /* ========================================
       ALERT MESSAGES
       Information, warning, and special day alerts
       ======================================== */
    .alert-info {
        background: #e0f2fe;           /* Light blue */
        border-left: 4px solid #0284c7;
        color: #075985;
        padding: 15px 20px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .alert-warning {
        background: #fef3c7;           /* Light yellow */
        border-left: 4px solid #f59e0b;
        color: #92400e;
        padding: 15px 20px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    /* ========================================
       HOLIDAY ALERT
       Shown when today is a holiday
       ======================================== */
    .alert-holiday {
        /* PINK-PURPLE GRADIENT */
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        padding: 30px;
        border-radius: 16px;
        margin-bottom: 30px;
        box-shadow: 0 6px 20px rgba(245, 87, 108, 0.3);
        text-align: center;
    }

    .alert-holiday h2 {
        margin: 0 0 15px 0;
        font-size: 32px;
    }

    .alert-holiday p {
        margin: 0;
        font-size: 18px;
        opacity: 0.95;
    }

    /* ========================================
       WEEKEND ALERT
       Shown when today is a weekend
       ======================================== */
    .alert-weekend {
        /* PURPLE GRADIENT */
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 30px;
        border-radius: 16px;
        margin-bottom: 30px;
        box-shadow: 0 6px 20px rgba(102, 126, 234, 0.3);
        text-align: center;
    }

    .alert-weekend h2 {
        margin: 0 0 15px 0;
        font-size: 32px;
    }

    .alert-weekend p {
        margin: 0;
        font-size: 18px;
        opacity: 0.95;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #2193b0;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s;
    }

    .back-link:hover {
        color: #1a7690;
        gap: 12px;
    }
</style>

<div class="mark-attendance-container">
    <!-- ========================================
         PAGE HEADER
         ======================================== -->
    <div class="header-section">
        <h2>
            <i class="fas fa-clock" style="color: #2193b0;"></i>
            Mark Your Attendance
        </h2>
        <p>Track your daily work hours efficiently</p>
    </div>

    <!-- ========================================
         NON-WORKING DAY CHECK
         Show holiday/weekend message if not working day
         ======================================== -->
    @if (!isWorkingDay)
    {
        @if (holiday != null)
        {
            <!-- Holiday message -->
            <div class="alert-holiday">
                <div style="font-size: 64px; margin-bottom: 15px;">&#127881;</div>
                <h2>@holiday.Name</h2>
                <p>Today is a holiday. No attendance marking required.</p>
                @if (!string.IsNullOrEmpty(holiday.Description))
                {
                    <p style="margin-top: 15px; font-size: 16px; opacity: 0.9;">@holiday.Description</p>
                }
            </div>
        }
        else if (isWeekend)
        {
            <!-- Weekend message -->
            <div class="alert-weekend">
                <div style="font-size: 64px; margin-bottom: 15px;">&#127958;&#65039;</div>
                <h2>Weekend</h2>
                <p>Today is a weekend. No attendance marking required.</p>
                <p style="margin-top: 15px; font-size: 16px; opacity: 0.9;">Enjoy your day off!</p>
            </div>
        }

        <div style="text-align: center; padding: 40px;">
            <a href="@Url.Action("Attendance", "EmployeePortal")" class="back-link" style="display: inline-block; padding: 15px 40px; background: linear-gradient(135deg, #6dd5ed 0%, #2193b0 100%); color: white; text-decoration: none; border-radius: 12px; font-weight: 600;">
                &larr; View My Attendance History
            </a>
        </div>
    }
    else
    {
        <!-- ========================================
             WORKING DAY - ATTENDANCE MARKING INTERFACE
             ======================================== -->
        
        <!-- Current Time Display (updates every second) -->
        <div class="current-time-display">
            <div class="time" id="currentTime">@DateTime.Now.ToString("hh:mm:ss tt")</div>
            <div class="date">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</div>
        </div>

        <!-- Employee Information -->
        <div class="employee-info-card">
            <div class="info-row">
                <div class="info-item">
                    <i class="fas fa-user"></i>
                    <div>
                        <p class="label">Employee Name</p>
                        <p class="value">@Model.Name</p>
                    </div>
                </div>
                <div class="info-item">
                    <i class="fas fa-id-badge"></i>
                    <div>
                        <p class="label">Employee Code</p>
                        <p class="value">@Model.EmployeeCode</p>
                    </div>
                </div>
                <div class="info-item">
                    <i class="fas fa-building"></i>
                    <div>
                        <p class="label">Department</p>
                        <p class="value">@Model.DepartmentNavigation?.Name</p>
                    </div>
                </div>
                @if (Model.ShiftNavigation != null)
                {
                    <div class="info-item">
                        <i class="fas fa-business-time"></i>
                        <div>
                            <p class="label">Shift Timing</p>
                            <p class="value">@Model.ShiftNavigation.StartTime.ToString(@"hh\:mm") - @Model.ShiftNavigation.EndTime.ToString(@"hh\:mm")</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- ========================================
             STATUS: NOT CHECKED IN YET
             ======================================== -->
        @if (todayAttendance == null)
        {
            <div class="alert-info">
                <i class="fas fa-info-circle"></i> You haven't checked in yet today. Click the button below to mark your check-in.
            </div>

            <div class="action-buttons">
                <button type="button" class="btn-action btn-checkin" id="btnCheckIn">
                    <i class="fas fa-sign-in-alt"></i> Check In
                </button>
            </div>
        }
        <!-- ========================================
             STATUS: CHECKED IN, NOT CHECKED OUT
             ======================================== -->
        else if (!todayAttendance.CheckOutTime.HasValue)
        {
            <div class="attendance-status-card">
                <h3>
                    <i class="fas fa-check-circle"></i>
                    Today's Attendance
                </h3>
                <div class="status-grid">
                    <div class="status-item">
                        <div class="label">Check-In Time</div>
                        <div class="value">@todayAttendance.CheckInTime.ToString(@"hh\:mm")</div>
                    </div>
                    <div class="status-item">
                        <div class="label">Status</div>
                        <div class="value">
                            @if (todayAttendance.IsLate)
                            {
                                <text>Late</text> <i class="fas fa-clock" style="color: #ef4444;"></i>
                            }
                            else
                            {
                                <text>On Time</text> <i class="fas fa-check" style="color: #10b981;"></i>
                            }
                        </div>
                    </div>
                    @if (todayAttendance.IsLate)
                    {
                        <div class="status-item">
                            <div class="label">Late By</div>
                            <div class="value">@todayAttendance.LateByMinutes min</div>
                        </div>
                    }
                </div>
            </div>

            <div class="alert-info">
                <i class="fas fa-info-circle"></i> You are currently checked in. Click the button below when you're ready to check out.
            </div>

            <div class="action-buttons">
                <button type="button" class="btn-action btn-checkout" id="btnCheckOut">
                    <i class="fas fa-sign-out-alt"></i> Check Out
                </button>
            </div>
        }
        <!-- ========================================
             STATUS: ALREADY CHECKED OUT
             ======================================== -->
        else
        {
            <div class="attendance-status-card">
                <h3>
                    <i class="fas fa-check-double"></i>
                    Today's Attendance Completed
                </h3>
                <div class="status-grid">
                    <div class="status-item">
                        <div class="label">Check-In</div>
                        <div class="value">@todayAttendance.CheckInTime.ToString(@"hh\:mm")</div>
                    </div>
                    <div class="status-item">
                        <div class="label">Check-Out</div>
                        <div class="value">@todayAttendance.CheckOutTime.Value.ToString(@"hh\:mm")</div>
                    </div>
                    <div class="status-item">
                        <div class="label">Total Hours</div>
                        <div class="value">@(todayAttendance.TotalHours?.ToString("0.00") ?? "0") hrs</div>
                    </div>
                    @if (todayAttendance.IsEarlyLeave && todayAttendance.EarlyLeaveByMinutes > 0)
                    {
                        <div class="status-item">
                            <div class="label">Early Leave</div>
                            <div class="value" style="color: #fb923c;">
                                @todayAttendance.EarlyLeaveByMinutes min
                                <i class="fas fa-clock" style="font-size: 14px;"></i>
                            </div>
                        </div>
                    }
                    @if (todayAttendance.OvertimeHours > 0)
                    {
                        <div class="status-item">
                            <div class="label">Overtime</div>
                            <div class="value" style="color: #6366f1;">
                                @todayAttendance.OvertimeHours.Value.ToString("0.00") hrs
                                <i class="fas fa-star" style="font-size: 14px;"></i>
                            </div>
                        </div>
                    }
                    @if (todayAttendance.IsHalfDay)
                    {
                        <div class="status-item">
                            <div class="label">Day Type</div>
                            <div class="value" style="color: #eab308;">
                                Half Day
                                <i class="fas fa-hourglass-half" style="font-size: 14px;"></i>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (todayAttendance.IsEarlyLeave)
            {
                <div class="alert-warning">
                    <i class="fas fa-exclamation-triangle"></i> 
                    You checked out early today (@todayAttendance.EarlyLeaveByMinutes minutes before shift end time).
                </div>
            }
            
            <div class="alert-info">
                <i class="fas fa-check-circle"></i> You have successfully completed your attendance for today. Have a great day!
            </div>
        }

        <div style="text-align: center; margin-top: 30px;">
            <a href="@Url.Action("Attendance", "EmployeePortal")" class="back-link">
                <i class="fas fa-arrow-left"></i> View My Attendance History
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        /* ========================================
           TIME UPDATE SCRIPT
           Updates current time every second
           ======================================== */
        function updateTime() {
            const now = new Date();
            const hours = now.getHours();
            const minutes = now.getMinutes();
            const seconds = now.getSeconds();
            const ampm = hours >= 12 ? 'PM' : 'AM';
            const displayHours = hours % 12 || 12;
            
            const timeString = `${displayHours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')} ${ampm}`;
            const timeElement = document.getElementById('currentTime');
            if (timeElement) {
                timeElement.textContent = timeString;
            }
        }

        setInterval(updateTime, 1000);

        /* Get anti-forgery token for AJAX requests */
        function getAntiForgeryToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        /* ========================================
           CHECK IN HANDLER
           Sends AJAX request to mark check-in
           ======================================== */
        const checkInBtn = document.getElementById('btnCheckIn');
        if (checkInBtn) {
            checkInBtn.addEventListener('click', function() {
                if (!confirm('Are you sure you want to check in now?')) {
                    return;
                }

                const btn = this;
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Checking In...';

                const formData = new FormData();
                formData.append('__RequestVerificationToken', getAntiForgeryToken());

                fetch('@Url.Action("CheckIn", "EmployeePortal")', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showToast(data.message, 'success');
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        showToast(data.message, 'error');
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fas fa-sign-in-alt"></i> Check In';
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showToast('An error occurred. Please try again.', 'error');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-sign-in-alt"></i> Check In';
                });
            });
        }

        /* ========================================
           CHECK OUT HANDLER
           Sends AJAX request to mark check-out
           ======================================== */
        const checkOutBtn = document.getElementById('btnCheckOut');
        if (checkOutBtn) {
            checkOutBtn.addEventListener('click', function() {
                if (!confirm('Are you sure you want to check out now?')) {
                    return;
                }

                const btn = this;
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Checking Out...';

                const formData = new FormData();
                formData.append('__RequestVerificationToken', getAntiForgeryToken());

                fetch('@Url.Action("CheckOut", "EmployeePortal")', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showToast(data.message, 'success');
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        showToast(data.message, 'error');
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fas fa-sign-out-alt"></i> Check Out';
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showToast('An error occurred. Please try again.', 'error');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-sign-out-alt"></i> Check Out';
                });
            });
        }

        /* Toast notification function */
        function showToast(message, type) {
            const toast = document.createElement('div');
            toast.className = `alert alert-${type === 'success' ? 'success' : 'danger'}`;
            toast.style.position = 'fixed';
            toast.style.top = '20px';
            toast.style.right = '20px';
            toast.style.zIndex = '9999';
            toast.style.minWidth = '300px';
            toast.style.padding = '15px 20px';
            toast.style.borderRadius = '8px';
            toast.style.boxShadow = '0 4px 12px rgba(0,0,0,0.15)';
            toast.innerHTML = `<strong>${type === 'success' ? '?' : '?'}</strong> ${message}`;
            document.body.appendChild(toast);
            
            setTimeout(() => {
                toast.style.transition = 'opacity 0.3s';
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 300);
            }, 5000);
        }
    </script>

    @Html.AntiForgeryToken()
}

<!-- ========================================
     QUICK MODIFICATION GUIDE
     ========================================
     
     TO CHANGE COLORS:
     - Time display: Line 60 (background gradient)
     - Check-in button: Line 120 (green gradient)
     - Check-out button: Line 129 (pink-yellow gradient)
     - Status card: Line 144 (purple gradient)
     - Holiday alert: Line 183 (pink-purple gradient)
     - Weekend alert: Line 201 (purple gradient)
     
     TO MODIFY ALERTS:
     - Info alert: Line 173 (light blue)
     - Warning alert: Line 180 (light yellow)
     
     DATA SOURCES:
     - Model: Employee object
     - ViewBag.TodayAttendance: Today's attendance record
     - ViewBag.IsWorkingDay: Boolean for working day check
     - ViewBag.Holiday: Holiday object if today is holiday
     - ViewBag.IsWeekend: Boolean for weekend check
     
     AJAX ENDPOINTS:
     - Check In: /EmployeePortal/CheckIn (POST)
     - Check Out: /EmployeePortal/CheckOut (POST)
     ======================================== -->
